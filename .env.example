# Platform: ctfd (default) or htb (Hack The Box CTF via its official MCP server)
PLATFORM=ctfd

# HTB CTF MCP — token from Profile Settings > MCP Access (shown once; expires)
HTB_MCP_TOKEN=
HTB_EVENT_ID=
# HTB_TEAM_ID=            # auto-detected via "my teams" if empty
# HTB_TOOL_SUBMIT_FLAG=   # override auto-detected MCP tool names if needed (see scripts/htb_mcp_probe.py)

# CTFd
CTFD_URL=https://ctf.example.com
CTFD_TOKEN=ctfd_your_api_token_here

# API Keys (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
